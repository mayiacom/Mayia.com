OPENAI_API_KEY=your_api_key_here
# Dodo Payments: start with test-mode keys and test subscription products.
DODO_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=your_dodo_test_api_key
DODO_PRODUCT_WEEKLY=your_weekly_subscription_product_id
DODO_PRODUCT_MONTHLY=your_monthly_subscription_product_id
DODO_PRODUCT_STUDIO=your_studio_subscription_product_id
DODO_PRODUCT_ANNUAL=your_annual_subscription_product_id
PUBLIC_APP_URL=https://mayia-az6g.onrender.com
# Optional: choose another model available to your API account
OPENAI_MODEL=gpt-4.1-mini
# Optional: change the local web server port
PORT=3210

